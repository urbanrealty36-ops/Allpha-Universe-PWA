# Comma-separated browser origins allowed to call the FastAPI API.
# Keep this explicit in staging/production; do not use wildcard origins with credentials.
ALLPHA_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# AI provider credential used only by the server-side AI Gateway.
OPENAI_API_KEY=

# Browser WebRTC NAT traversal (recommended for production)
NEXT_PUBLIC_WEBRTC_TURN_URL=
NEXT_PUBLIC_WEBRTC_TURN_USERNAME=
NEXT_PUBLIC_WEBRTC_TURN_CREDENTIAL=
