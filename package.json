{
  "name": "allpha-universe",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev:web": "pnpm --filter @allpha/web dev",
    "dev:admin": "pnpm --filter @allpha/admin dev",
    "dev:api": "cd apps/api && python -m uvicorn app.main:app --reload --port 8000",
    "build:web": "pnpm --filter @allpha/web build",
    "build:admin": "pnpm --filter @allpha/admin build",
    "validate:3d:assets": "node scripts/3d/production-asset-pipeline.mjs validate",
    "manifest:3d:assets": "node scripts/3d/production-asset-pipeline.mjs manifest",
    "activate:3d:assets": "node scripts/3d/activate-production-assets.mjs --root=allpha-theme-v2-production-3d-350-pack",
    "qa:3d:v2.12": "node scripts/3d/qa-harness-v2-12.mjs",
    "qa:3d:v2.13": "node scripts/3d/qa-v2-13-production-art.mjs",
    "build:3d:v2.13:golden": "blender -b --python scripts/3d/blender/build_v2_13_production_art.py -- --theme crystal-ai-city --preview",
    "build:3d:v2.13:full": "blender -b --python scripts/3d/blender/build_v2_13_production_art.py -- --all",
    "validate:3d:v2.13b": "node scripts/3d/validate-v2-13b-golden-pack.mjs",
    "activate:3d:v2.13b": "node scripts/3d/activate-v2-13b-crystal-golden.mjs --root=allpha-theme-v2-13-golden-pack",
    "validate:3d:v2.13c": "node scripts/3d/generate-v2-13c-theme-factory-manifest.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
